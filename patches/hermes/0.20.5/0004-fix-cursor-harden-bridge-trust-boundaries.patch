+class TestBridgeDownloadSecurity:
+    def test_unknown_architecture_is_rejected(self, monkeypatch):
+        monkeypatch.setattr("sys.platform", "linux")
+        monkeypatch.setattr("platform.machine", lambda: "riscv64")
+
+        with pytest.raises(CursorBridgeError, match="unsupported bridge architecture"):
+            bridge_transport.bridge_platform()
+
+    def test_checksum_metadata_is_required_and_mirror_is_never_used(
+        self, tmp_path, monkeypatch
+    ):
+        monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+        monkeypatch.setattr(bridge_transport, "bridge_platform", lambda: ("linux", "x64"))
+        monkeypatch.setattr(
+            bridge_transport, "_expected_archive_sha256", lambda _version, _name: None
+        )
+        fetched = []
+
+        def fake_fetch(url, timeout=120):
+            fetched.append(url)
+            return b"not-an-archive"
+
+        monkeypatch.setattr(bridge_transport, "_fetch_url", fake_fetch)
+
+        with pytest.raises(CursorBridgeError, match="checksum metadata unavailable"):
+            bridge_transport.download_bridge(progress=False)
+
+        assert all("downloads.cursor.com" not in url for url in fetched)
+
+
+class TestBridgeSubprocessEnvironment:
+    def test_only_cursor_credential_is_added_to_sanitized_environment(self, monkeypatch):
+        calls = []
+
+        def fake_subprocess_env(*, inherit_credentials):
+            calls.append(inherit_credentials)
+            return {"PATH": "safe", "OPENAI_API_KEY": "must-not-survive"}
+
+        monkeypatch.setattr(
+            "tools.environments.local.hermes_subprocess_env", fake_subprocess_env
+        )
+
+        env = bridge_transport._build_subprocess_env("cursor-only")
+
+        assert calls == [False]
+        assert env["CURSOR_API_KEY"] == "cursor-only"
+        assert "OPENAI_API_KEY" not in env
+
