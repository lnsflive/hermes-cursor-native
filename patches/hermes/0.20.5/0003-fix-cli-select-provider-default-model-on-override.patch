From 197cd728d5970ea35e4e62385b65299fdadfbdac Mon Sep 17 00:00:00 2001
From: Jaime Gonzalez <lnsflive@gmail.com>
Date: Fri, 21 Aug 2026 23:33:53 -0500
Subject: [PATCH 3/4] fix(cli): select provider default model on override

---
 cli.py                                    | 14 ++++++++++++++
 tests/cli/test_cli_provider_resolution.py | 15 +++++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/cli.py b/cli.py
index 66ca51cdf1..7c8b6017fe 100644
--- a/cli.py
+++ b/cli.py
@@ -5212,6 +5212,20 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
                 )
                 _named_custom = None
             _provider_default = str((_named_custom or {}).get("model") or "").strip()
+            if not _provider_default:
+                try:
+                    from hermes_cli.models import get_default_model_for_provider
+
+                    _provider_default = str(
+                        get_default_model_for_provider(provider) or ""
+                    ).strip()
+                except Exception as exc:
+                    logger.warning(
+                        "Could not resolve registered provider %s default model; "
+                        "keeping global model.default (%s)",
+                        provider,
+                        exc,
+                    )
             if _provider_default:
                 self.model = _provider_default
                 self._model_is_default = False
diff --git a/tests/cli/test_cli_provider_resolution.py b/tests/cli/test_cli_provider_resolution.py
index ff4734f896..c3eda362a0 100644
--- a/tests/cli/test_cli_provider_resolution.py
+++ b/tests/cli/test_cli_provider_resolution.py
@@ -151,6 +151,21 @@ def test_provider_flag_uses_named_custom_default_model(monkeypatch):
     assert shell.requested_provider == "gmk-lan"
 
 
+def test_provider_flag_uses_registered_provider_default_model(monkeypatch):
+    """`--provider cursor` must not retain another provider's model."""
+    cli = _import_cli()
+    monkeypatch.setitem(
+        cli.CLI_CONFIG,
+        "model",
+        {"default": "gpt-5.6-sol", "provider": "openai-codex"},
+    )
+
+    shell = cli.HermesCLI(provider="cursor", compact=True, max_turns=1)
+
+    assert shell.model == "auto"
+    assert shell.requested_provider == "cursor"
+
+
 def test_explicit_model_wins_over_provider_default_model(monkeypatch):
     """`-m` still wins when `--provider` also names a custom default_model."""
     cli = _import_cli()
-- 
