+@pytest.fixture()
+def callback_server():
+    received = []
+
+    def handler(request):
+        received.append(request)
+        return {"value": "handled"}
+
+    server = _ToolCallbackServer(handler)
+    server.start()
+    yield server, received
+    server.stop()
